# ===== Database =====
# Chạy local (ngoài Docker): host = localhost, cổng = POSTGRES_PORT bên dưới.
# Trong docker compose, biến này bị override thành host "postgres" (xem docker-compose.yml).
# Pytest dùng database "<tên>_test" (data_cleaning_test), được tạo bởi docker/postgres-init.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_cleaning
# Cổng Postgres trên máy host (đổi nếu 5432 đã bị chiếm; nhớ sửa cổng trong DATABASE_URL)
POSTGRES_PORT=5432

# ===== JWT / Auth =====
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== AI Provider =====
# "openai" hoac "anthropic"
AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Storage (S3-compatible: Supabase Storage / Cloudflare R2) =====
STORAGE_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
STORAGE_BUCKET=data-cleaning-platform
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ===== Frontend =====
BACKEND_URL=http://localhost:8000

# ===== App / CORS =====
APP_NAME=Data Cleaning Platform
ENVIRONMENT=development
# Định dạng JSON list. ["*"] chỉ dùng khi dev; trên production phải liệt kê origin cụ thể
# (backend đang bật allow_credentials=True, không được kết hợp với "*").
CORS_ORIGINS=["http://localhost:8501"]

# ===== Upload =====
MAX_UPLOAD_MB=50
