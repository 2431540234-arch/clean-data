# ===== Database =====
# Chạy local (ngoài Docker): host = localhost, cổng = POSTGRES_PORT bên dưới.
# Trong docker compose, biến này bị override thành host "postgres" (xem docker-compose.yml).
# Pytest dùng database "<tên>_test" (data_cleaning_test), được tạo bởi docker/postgres-init.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_cleaning
# Cổng Postgres trên máy host (đổi nếu 5432 đã bị chiếm; nhớ sửa cổng trong DATABASE_URL)
POSTGRES_PORT=5432

# ===== JWT / Auth =====
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== AI Provider =====
# "openai" hoac "anthropic". KHÔNG có khóa thì AI tự tắt, hệ thống chỉ dùng gợi ý theo quy tắc.
# Không bao giờ commit khóa thật: chỉ điền vào file .env (đã nằm trong .gitignore).
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_SECONDS=20
AI_MAX_COLUMNS=40
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Storage =====
# Rỗng = tự chọn: có STORAGE_ENDPOINT thì dùng S3, ngược lại lưu vào thư mục local (đủ cho demo).
# Đặt "local" hoặc "s3" để ép một driver.
STORAGE_BACKEND=
STORAGE_LOCAL_DIR=data/storage
# S3-compatible (Supabase Storage / Cloudflare R2), chỉ cần khi dùng S3:
STORAGE_ENDPOINT=
STORAGE_BUCKET=data-cleaning-platform
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ===== Frontend =====
BACKEND_URL=http://localhost:8000

# ===== App / CORS =====
APP_NAME=Data Cleaning Platform
ENVIRONMENT=development
# Định dạng JSON list. ["*"] chỉ dùng khi dev; trên production phải liệt kê origin cụ thể
# (backend đang bật allow_credentials=True, không được kết hợp với "*").
CORS_ORIGINS=["http://localhost:8501"]

# Chỉ bật khi backend nằm sau reverse proxy tin cậy (lấy IP thật từ X-Forwarded-For)
TRUST_PROXY_HEADERS=false

# ===== Upload =====
MAX_UPLOAD_MB=50
# Tải lên theo từng phần (chỉ CSV): trần tổng sau khi ghép (MB), kích thước mỗi phần (MB), giữ phiên dở (phút)
MAX_CHUNKED_UPLOAD_MB=200
UPLOAD_PART_MB=8
UPLOAD_SESSION_TTL_MINUTES=60
MAX_UPLOAD_ROWS=1000000
MAX_UPLOAD_COLUMNS=500

# ===== Chống dò mật khẩu =====
# Tối đa N lần đăng nhập sai trong M phút theo (email, IP), vượt thì trả 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=50
