# ===== Database =====
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_cleaning

# ===== JWT / Auth =====
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== AI Provider =====
# "openai" hoac "anthropic"
AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Storage (S3-compatible: Supabase Storage / Cloudflare R2) =====
STORAGE_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
STORAGE_BUCKET=data-cleaning-platform
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ===== Frontend =====
BACKEND_URL=http://localhost:8000

# ===== Upload =====
MAX_UPLOAD_MB=50
